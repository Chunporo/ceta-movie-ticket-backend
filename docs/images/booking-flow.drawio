ont-size:11px&quot; color=&quot;#4A5160&quot;&gt;VNPay · MoMo · bank feed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5E1;strokeColor=#D4533B;strokeWidth=1.6;arcSize=12;" vertex="1" parent="1"><mxGeometry x="860.0" y="56" width="180" height="76" as="geometry"/></mxCell><mxCell id="s0" value="1. POST /bookings  (seats, combos, voucher)" style="endArrow=block;strokeColor=#4A5160;strokeWidth=1.6;fontSize=12;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="190" as="sourcePoint"/><mxPoint x="420" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1" value="2. seats AVAILABLE → HELD (all or nothing)" style="endArrow=block;strokeColor=#4A5160;strokeWidth=1.6;fontSize=12;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="244" as="sourcePoint"/><mxPoint x="730" y="244" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2" value="3. booking PENDING · total frozen · hold 10 min" style="endArrow=block;strokeColor=#4A5160;strokeWidth=1.6;fontSize=12;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="298" as="sourcePoint"/><mxPoint x="120" y="298" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3" value="4. POST /payments/vnpay/create-url" style="endArrow=block;strokeColor=#4A5160;strokeWidth=1.6;fontSize=12;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="352" as="sourcePoint"/><mxPoint x="420" y="352" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s4" value="5. payment_transaction  (bookingId_attempt)" style="endArrow=block;strokeColor=#4A5160;strokeWidth=1.6;fontSize=12;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="406" a